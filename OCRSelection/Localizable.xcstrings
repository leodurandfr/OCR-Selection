    "Copy each line exactly as it appears on screen instead of rejoining wrapped lines into paragraphs. Useful for code and poems." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy each line exactly as it appears on screen instead of rejoining wrapped lines into paragraphs. Useful for code and poems."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia cada línea tal como aparece en pantalla en lugar de unir las líneas cortadas en párrafos. Útil para código y poemas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie chaque ligne telle qu’elle apparaît à l’écran au lieu de recoller les lignes coupées en paragraphes. Utile pour le code et les poèmes."
          }
        }
      }
    },
