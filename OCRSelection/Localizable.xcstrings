    "Text recognition failed because macOS deleted the app's files to free up space. Try again in a minute, and free up disk space to prevent this." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text recognition failed because macOS deleted the app's files to free up space. Try again in a minute, and free up disk space to prevent this."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reconocimiento de texto falló porque macOS eliminó archivos de la app para liberar espacio. Vuelve a intentarlo en un minuto y libera espacio en disco para evitarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reconnaissance du texte a échoué car macOS a supprimé des fichiers de l'app pour libérer de l'espace. Réessayez dans une minute, et libérez de l'espace disque pour éviter cela."
          }
        }
      }
    },
    "Text recognition is taking longer than usual because macOS deleted the app's files to free up space. It is still working and can take up to a minute or two. Free up disk space to prevent this." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text recognition is taking longer than usual because macOS deleted the app's files to free up space. It is still working and can take up to a minute or two. Free up disk space to prevent this."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reconocimiento de texto está tardando más de lo habitual porque macOS eliminó los archivos de la app para liberar espacio. Sigue trabajando y puede tardar uno o dos minutos. Libera espacio en disco para evitarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reconnaissance du texte prend plus de temps que d'habitude car macOS a supprimé les fichiers de l'app pour libérer de l'espace. Elle continue et peut prendre une à deux minutes. Libérez de l'espace disque pour éviter cela."
          }
        }
      }
    },
    "Text recognition was slow because the disk is almost full. Free up disk space to speed it up." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text recognition was slow because the disk is almost full. Free up disk space to speed it up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reconocimiento de texto fue lento porque el disco está casi lleno. Libera espacio en disco para acelerarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reconnaissance du texte a été lente car le disque est presque plein. Libérez de l'espace disque pour l'accélérer."
          }
        }
      }
    },
    "The capture succeeded but text recognition failed. Try again in a moment." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The capture succeeded but text recognition failed. Try again in a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La captura se realizó, pero el reconocimiento de texto falló. Vuelve a intentarlo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La capture a réussi mais la reconnaissance du texte a échoué. Réessayez dans un instant."
          }
        }
      }
    },
